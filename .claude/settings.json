{
  "permissions": {
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Write(*.html)",
      "Write(*.md)",
      "Write(*.json)",
      "Edit(*.html)",
      "Edit(*.md)",
      "Edit(*.json)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git pull)",
      "Bash(npx live-server *)",
      "Bash(ls *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "env": {
    "LANG": "zh_CN.UTF-8"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [{"type": "command", "command": "node -e \"const p=process.env.CLAUDE_FILE_PATH; if(p && p.includes('Docs/')) { console.log('blocked: Docs目录是源文档，不应直接修改'); process.exit(1); }\""}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [{"type": "command", "command": "node -e \"const p=process.env.CLAUDE_FILE_PATH; if(p && p.endsWith('.html')) { console.log('提示: HTML文件已创建/修改，记得检查链接和导航'); }\""}]
      },
      {
        "matcher": "Edit",
        "hooks": [{"type": "command", "command": "node -e \"const p=process.env.CLAUDE_FILE_PATH; if(p && p.endsWith('.html')) { console.log('提示: HTML文件已修改，建议本地预览确认效果'); }\""}]
      }
    ]
  }
}
